# ============================================================
# Hikvision AI CCTV Platform — Environment Configuration
# Copy this file to .env and fill in your actual values
# ============================================================

# --- Hikvision Recorder Credentials ---
HIK_NVR_IP=192.168.0.29
HIK_NVR_PORT=554
HIK_NVR_USER=admin
HIK_NVR_PASSWORD=kanojia@123

HIK_DVR_IP=192.168.0.11
HIK_DVR_PORT=554
HIK_DVR_USER=admin
HIK_DVR_PASSWORD=kanojia@123

# --- CP Plus Standalone Camera ---
CPPLUS_CAM_IP=192.168.0.33
CPPLUS_CAM_PORT=554
CPPLUS_CAM_USER=admin
CPPLUS_CAM_PASSWORD=Kanojia@123@

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cctv_ai
POSTGRES_USER=cctv_admin
POSTGRES_PASSWORD=SecureDbPassword!2026

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- MQTT (Mosquitto) ---
MQTT_HOST=mosquitto
MQTT_PORT=1883

# --- Frigate ---
FRIGATE_HOST=frigate
FRIGATE_PORT=5000
FRIGATE_RTSP_PASSWORD=FrigateRTSP2026

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-this-to-a-random-secret-key-in-production

# --- Media Storage ---
MEDIA_DIR=/app/media
MEDIA_MAX_SIZE_GB=40
MEDIA_RETENTION_DAYS=21

# --- AI Model Paths (inside container) ---
YOLO_MODEL_PATH=/app/models/yolov8n.onnx
INSIGHTFACE_MODEL_PATH=/app/models/insightface
LPR_MODEL_PATH=/app/models/lprnet.onnx
CLIP_MODEL_PATH=/app/models/mobileclip_s2.onnx
